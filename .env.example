# Database Configuration
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Google Drive Backup Configuration (OAuth 2.0)
# Get these from Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"
# Folder ID from Google Drive URL where backups will be stored
# Get by opening folder in Drive and copying ID from URL: drive.google.com/drive/folders/[FOLDER_ID]
GOOGLE_DRIVE_FOLDER_ID="1234567890abcdefghijklmnop"

# Vercel Cron Security
# Generate a secure random string for cron job authentication
CRON_SECRET="your-secure-random-string-here"

# Backup Configuration (Optional)
# Number of days to retain backups in Google Drive (default: 90)
BACKUP_RETENTION_DAYS="90"
# Number of records to fetch per batch during backup (default: 1000)
BACKUP_CHUNK_SIZE="1000"
